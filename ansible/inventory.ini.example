[web]
web ansible_host=WEB_PUBLIC_IP private_ip=WEB_PRIVATE_IP

[db]
db ansible_host=DB_PRIVATE_IP

[all:vars]
ansible_user=ec2-user
ansible_ssh_private_key_file=~/.ssh/travelmemory

[db:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -i ~/.ssh/travelmemory -o IdentitiesOnly=yes -W %h:%p ec2-user@YOUR_WEB_PUBLIC_IP"'

